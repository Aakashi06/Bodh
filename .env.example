# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Reasoning LLM — Sarvam for Hinglish voice; switch to ollama without changing the API
LLM_PROVIDER=sarvam
LLM_MODEL=sarvam-105b-conversations
LLM_API_KEY=
LLM_BASE_URL=https://api.sarvam.ai
LLM_TIMEOUT_SECONDS=120

# Sarvam AI — chat, STT, TTS (leave LLM_API_KEY empty to reuse SARVAM_API_KEY)
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saaras:v4
SARVAM_STT_MODE=codemix
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_LANGUAGE_CODE=hi-IN
SARVAM_TIMEOUT_SECONDS=60

# Frontend (Vite)
VITE_API_BASE_URL=http://127.0.0.1:8000
